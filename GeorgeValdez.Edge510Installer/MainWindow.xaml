<Window x:Class="GeorgeValdez.Edge510Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edge 510 · Asistente OPNsense" Height="760" Width="1140" MinHeight="640" MinWidth="920"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}" FontFamily="Segoe UI" Foreground="{StaticResource Ink}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#15242B">
            <Grid Margin="20,30,20,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="10,0,0,32">
                    <TextBlock Text="Edge 510" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Instalar OPNsense" FontSize="14" Foreground="#A5B4B9" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel x:Name="NavSteps" Grid.Row="1">
                    <Button x:Name="Nav1" Click="Nav_Click" Tag="0" Background="Transparent" Foreground="#C7D0D3"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Padding="12,0" Height="58" Margin="0,3">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Dot1" Width="26" Height="26" CornerRadius="13" Background="#34454C" VerticalAlignment="Center">
                                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Consola y USB" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                        </Grid>
                    </Button>
                    <Button x:Name="Nav2" Click="Nav_Click" Tag="1" Background="Transparent" Foreground="#C7D0D3"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Padding="12,0" Height="58" Margin="0,3">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Dot2" Width="26" Height="26" CornerRadius="13" Background="#34454C" VerticalAlignment="Center">
                                <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Descargar OPNsense" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                        </Grid>
                    </Button>
                    <Button x:Name="Nav3" Click="Nav_Click" Tag="2" Background="Transparent" Foreground="#C7D0D3"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Padding="12,0" Height="58" Margin="0,3">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Dot3" Width="26" Height="26" CornerRadius="13" Background="#34454C" VerticalAlignment="Center">
                                <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Crear USB" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                        </Grid>
                    </Button>
                    <Button x:Name="Nav4" Click="Nav_Click" Tag="3" Background="Transparent" Foreground="#C7D0D3"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Padding="12,0" Height="58" Margin="0,3">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Dot4" Width="26" Height="26" CornerRadius="13" Background="#34454C" VerticalAlignment="Center">
                                <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Instalar en el Edge" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                        </Grid>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="10,20,0,0">
                    <TextBlock Text="George Valdez" FontSize="12" Foreground="#C5D0D3"/>
                    <TextBlock x:Name="BuildVersion" FontSize="11" Foreground="#829399" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="32,30,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,24">
                <TextBlock x:Name="Eyebrow" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                <StackPanel x:Name="PageHost"/>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" MaxHeight="50"/>
                <Button Grid.Column="1" x:Name="BackButton" Content="Volver" Style="{StaticResource QuietButton}" Click="Back_Click" Margin="0,0,10,0"/>
                <Button Grid.Column="2" x:Name="NextButton" Content="Continuar" Click="Next_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
